# Copy to .env for local `expo start` (not committed).
# EAS builds use eas.json env blocks or EAS environment variables instead.

# Read by lib/supabase.ts. The ANON_KEY name is kept for the code; the value is the
# project's publishable key (sb_publishable_...), which is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://xuviwarpgvxzpouqesrv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_MkxfcKbIk2U5k88mF7QhtQ_NVlGH05Y
# Optional. lib/notifications.ts uses app.json extra.eas.projectId first and only
# falls back to this.
EXPO_PUBLIC_EAS_PROJECT_ID=

# PostHog product analytics (optional locally — no events emitted without a key)
# Read by components/AnalyticsProvider.tsx.
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting (production builds only). Read by lib/sentry.ts.
# EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Set to "true" to skip GPS geofence checks. lib/constants.ts honours it only when
# __DEV__ is true, so release builds ignore it.
# EXPO_PUBLIC_BYPASS_GEOFENCE=true

# Add this exact redirect URL in Supabase → Authentication → URL Configuration:
#   quest://reset-password
# For Expo Go during dev, also add the URL from Linking.createURL (exp://…/--/reset-password).
