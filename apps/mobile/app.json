{
  "expo": {
    "name": "Quest!",
    "slug": "kuest",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "quest",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "31903b75-d817-4713-9211-a0cd8a167921"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quest.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Quest! uses your location to verify quest completions.",
        "NSCameraUsageDescription": "Quest! uses your camera to submit quest proof photos.",
        "NSPhotoLibraryUsageDescription": "Quest! uses your photo library to set your avatar."
      }
    },
    "android": {
      "package": "com.quest.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFCE1F"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F2EC"
        }
      ],
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Quest! uses your photo library to set your avatar."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Quest! uses your camera for quest proof photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FFCE1F"
        }
      ],
      "expo-localization"
    ],
    "owner": "rahil1"
  }
}
