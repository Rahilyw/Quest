# Index of the env vars the code reads. Each app keeps its own example file:
#   apps/mobile/.env.example  -> copy to apps/mobile/.env
#   apps/admin/.env.example   -> copy to apps/admin/.env.local
# Nothing reads a root .env. The names below match the code as of Nov 25, 2026.
# Get values from Supabase Dashboard -> Connect (or Project Settings -> API keys).

# --- Mobile (apps/mobile, read by Expo at build time) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Holds the publishable key (sb_publishable_...). The name still says ANON_KEY
# because lib/supabase.ts reads that name.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Optional: lib/notifications.ts falls back to this only if app.json has no
# extra.eas.projectId (it does).
# EXPO_PUBLIC_EAS_PROJECT_ID=
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# EXPO_PUBLIC_BYPASS_GEOFENCE=true   # dev builds only (__DEV__); ignored in release

# --- Admin (apps/admin, Next.js) ---
# Server side: lib/supabase.ts, lib/supabase-server.ts, middleware.ts
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret key (service-role access). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Browser side: lib/supabase-browser.ts (password reset)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# lib/admin-auth.ts. Empty denies every login.
ADMIN_ALLOWED_EMAILS=you@example.com
# ADMIN_DEV_ALLOW_ALL=1   # local only; ignored when NODE_ENV=production

# --- Edge functions (supabase/functions) ---
# Not read from any file. Set with `npx supabase secrets set NAME=value` (owner).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are read with Deno.env.get and come
# from the Supabase functions runtime; do not set them by hand.
# DROP_PUSH_WEBHOOK_SECRET=<long random>     # send-push-outbox (x-webhook-secret)
# SOCIAL_PUSH_WEBHOOK_SECRET=<long random>   # send-social-push (x-webhook-secret)
